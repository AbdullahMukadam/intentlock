# Copy to packages/evals/.env

# Model, only for --modes model: openai-compatible needs LLM_BASE_URL + LLM_MODEL; anthropic needs LLM_API_KEY + LLM_MODEL
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Optional
EVAL_TURN_DELAY_MS=1500
INTENTLOCK_URL=http://localhost:3000
INTENTLOCK_EVAL_API_KEY=
INTENTLOCK_EVAL_USER=member@acme-demo.dev
