{
  "name": "@intentlock/cli",
  "version": "0.3.1",
  "description": "The intentlock CLI: verify audit exports offline, create signing keys, manage users, agents, keys and policies.",
  "private": false,
  "license": "Elastic-2.0",
  "keywords": [
    "intentlock",
    "cli",
    "llm",
    "agents",
    "authorization",
    "audit"
  ],
  "homepage": "https://github.com/AbdullahMukadam/intentlock/tree/main/packages/cli#readme",
  "bugs": "https://github.com/AbdullahMukadam/intentlock/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdullahMukadam/intentlock.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {
    "@intentlock/core": "workspace:*",
    "commander": "^15.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@intentlock/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "intentlock": "dist/bin.js"
  }
}
