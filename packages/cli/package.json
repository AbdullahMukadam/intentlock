{
  "name": "@intentlock/cli",
  "version": "0.0.0",
  "description": "The intentlock CLI: audit verify, keygen, policy validate, admin commands.",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@intentlock/core": "workspace:*",
    "commander": "^15.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@intentlock/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "intentlock": "dist/bin.js"
  }
}
