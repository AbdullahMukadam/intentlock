{
  "name": "@intentlock/guard",
  "version": "0.3.0",
  "description": "Provider-agnostic agent guard: LLMProvider interface, planner, guarded tool loop.",
  "private": false,
  "license": "MIT",
  "keywords": [
    "llm",
    "agents",
    "tool-calling",
    "authorization",
    "prompt-injection",
    "openai"
  ],
  "homepage": "https://github.com/AbdullahMukadam/intentlock/tree/main/packages/guard#readme",
  "bugs": "https://github.com/AbdullahMukadam/intentlock/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdullahMukadam/intentlock.git",
    "directory": "packages/guard"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {
    "@intentlock/core": "workspace:*",
    "@intentlock/sdk": "workspace:*",
    "openai": "^7.32.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@intentlock/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
