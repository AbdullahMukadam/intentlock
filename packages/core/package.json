{
  "name": "@intentlock/core",
  "version": "0.4.0",
  "description": "Pure core: plan schema, canonicalization, signing, policy engine, check(), audit hashing.",
  "private": false,
  "license": "MIT",
  "keywords": [
    "llm",
    "agents",
    "authorization",
    "policy",
    "audit",
    "prompt-injection"
  ],
  "homepage": "https://github.com/AbdullahMukadam/intentlock/tree/main/packages/core#readme",
  "bugs": "https://github.com/AbdullahMukadam/intentlock/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdullahMukadam/intentlock.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {
    "canonicalize": "^5.1.0",
    "jose": "^6.2.12",
    "minimatch": "^10.2.6",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@intentlock/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
