{
  "name": "@intentlock/sdk",
  "version": "0.3.1",
  "description": "Gates: HybridGate (local decisions + audit outbox), HttpGate, LocalGate, PassThroughGate.",
  "private": false,
  "license": "MIT",
  "keywords": [
    "llm",
    "agents",
    "authorization",
    "gate",
    "audit",
    "prompt-injection"
  ],
  "homepage": "https://github.com/AbdullahMukadam/intentlock/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/AbdullahMukadam/intentlock/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdullahMukadam/intentlock.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/local.ts",
    "prepack": "tsup"
  },
  "dependencies": {
    "@intentlock/core": "workspace:*",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@intentlock/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
