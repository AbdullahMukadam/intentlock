{
  "name": "@intentlock/anthropic",
  "version": "0.1.0",
  "description": "Anthropic adapter implementing the Intentlock LLMProvider interface.",
  "private": false,
  "license": "MIT",
  "keywords": [
    "llm",
    "agents",
    "tool-calling",
    "authorization",
    "anthropic",
    "claude"
  ],
  "homepage": "https://github.com/AbdullahMukadam/intentlock/tree/main/packages/anthropic#readme",
  "bugs": "https://github.com/AbdullahMukadam/intentlock/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdullahMukadam/intentlock.git",
    "directory": "packages/anthropic"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@intentlock/guard": "workspace:*"
  },
  "devDependencies": {
    "@intentlock/config": "workspace:*",
    "@intentlock/core": "workspace:*",
    "@intentlock/sdk": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
