# Copy to .env and fill in. Never commit .env.

# --- Server (apps/server) ---
# Pooled URL at runtime; direct URL for migrations (same value locally)
DATABASE_URL=postgresql://intentlock:intentlock@localhost:5432/intentlock
DIRECT_URL=postgresql://intentlock:intentlock@localhost:5432/intentlock
# Optional database limits (defaults shown): connections per instance, wait for a connection,
# wait to start a transaction, total transaction time. Exceeding them answers 503.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_TIMEOUT_MS=5000
# DATABASE_TX_MAX_WAIT_MS=2000
# DATABASE_TX_TIMEOUT_MS=5000
# Separate database used by integration tests
TEST_DATABASE_URL=postgresql://intentlock:intentlock@localhost:5432/intentlock_test
# Ed25519 PKCS8 PEM for plan signing (generate with `intentlock keygen`). Unset in dev = generated and printed once.
SIGNING_KEY=
# Optional: previous signing key, still published in JWKS during rotation
SIGNING_KEY_PREVIOUS=
# Optional extra secret mixed into API key hashes
API_KEY_PEPPER=
ORG_NAME=Acme Demo
# Optional SMTP for invite and reset emails; Mailpit in dev (docker compose up -d mailpit, inbox at http://localhost:8025)
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM=Intentlock <intentlock@acme-demo.dev>
# Optional "Continue with Google / GitHub"; callback <PUBLIC_URL>/api/v1/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional path to a license JWS; absent = Community edition
LICENSE_FILE=
# External URL of the single origin (cookies, links)
PUBLIC_URL=http://localhost:3001
# Reverse proxies in front of the server (0 = none; 1 behind nginx or Render)
TRUST_PROXY=0
# Only if the inbox is served from another origin (avoid)
CORS_ORIGINS=
# 1 = completing setup also creates sample users (passwords printed once); never in real installs
INTENTLOCK_DEMO=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Inbox (apps/inbox) ---
# Server URL the inbox's /api rewrite forwards to (read at build time)
API_URL=http://localhost:3000

# --- Agent apps / demo (local only, never on the server) ---
INTENTLOCK_URL=http://localhost:3000
INTENTLOCK_API_KEY=
# openai-compatible | anthropic | fake; default free model is gemini-3.5-flash-lite on Gemini (ADR-012)
LLM_PROVIDER=fake
# e.g. https://generativelanguage.googleapis.com/v1beta/openai/ (Gemini), https://api.groq.com/openai/v1, http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Throwaway account, fine-grained PAT (demo only)
GITHUB_TOKEN=
# Owner (account or org) of the demo repos, and the repo names
GITHUB_OWNER=
GITHUB_PUBLIC_REPO=public-app
GITHUB_PRIVATE_REPO=private-notes
# Demo setup signs in as this admin, with the password or a CLI token (account settings)
INTENTLOCK_ADMIN_EMAIL=
INTENTLOCK_ADMIN_PASSWORD=
INTENTLOCK_ADMIN_TOKEN=
# Team member the demo agents act for (INTENTLOCK_DEMO=1 creates member@<domain>; setup creates it if missing).
# Holds need someone other than this user to approve.
DEMO_USER=member@acme-demo.dev
# 1 = scripted FakeProvider emits the injected calls (labelled on screen)
DEMO_FORCE_ATTACK=0
# Pause before each model call, for free-tier rate limits
DEMO_TURN_DELAY_MS=1500
# Mailpit HTTP API for support-assistant (docker compose up -d mailpit; web UI on the same port)
MAILPIT_URL=http://localhost:8025
# apps/demo/.env (written by setup): INTENTLOCK_API_KEY_GITHUB_ASSISTANT=il_live_..., INTENTLOCK_API_KEY_SUPPORT_ASSISTANT=il_live_..., INTENTLOCK_API_KEY_FILES_ASSISTANT=il_live_...
# files-assistant: sandbox folder (default apps/demo/sandbox) and the receiver its seeded attack targets
DEMO_SANDBOX=
DEMO_RECEIVER_URL=http://localhost:8787/collect
# Evals: optional latency bench against a server (an agent key whose policy allows fs_read in the plan,
# e.g. the files-assistant key) and pacing between model calls for free tiers
INTENTLOCK_EVAL_API_KEY=
INTENTLOCK_EVAL_USER=member@acme-demo.dev
EVAL_TURN_DELAY_MS=1500
