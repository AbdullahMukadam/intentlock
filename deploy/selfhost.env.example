# Copy to .env next to docker-compose.selfhost.yml. Never commit it.

# Name of your team, shown in the inbox
ORG_NAME=Acme
# The URL your team opens in the browser (https://... in production, behind your TLS proxy)
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Long random password for the bundled Postgres. Leave this line out and append it with:
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" >> .env

# Ed25519 plan-signing key (keep it secret, back it up). Leave this line out and append it with:
#   echo "SIGNING_KEY=\"$(openssl genpkey -algorithm ed25519)\"" >> .env
# or paste the one-line value from: intentlock keygen --env

# Optional extra secret mixed into API key hashes (set once; changing it invalidates all API keys)
API_KEY_PEPPER=

# Optional email for invite and password-reset links (unset = links are only shown to copy)
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
SMTP_FROM=Intentlock <intentlock@acme.dev>

# Optional "Continue with Google / GitHub" (existing and invited users only).
# Callback URL to register with the provider: <PUBLIC_URL>/api/v1/auth/oauth/<google|github>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional license: put the file in ./license/ and set LICENSE_FILE=/license/<file name>
LICENSE_FILE=

# Image tag to run (pin a version in production)
INTENTLOCK_VERSION=latest
LOG_LEVEL=info
