# Copy to apps/demo/.env

# Required for setup-instance: the admin email plus a password or a CLI token
INTENTLOCK_ADMIN_EMAIL=
INTENTLOCK_ADMIN_PASSWORD=
INTENTLOCK_ADMIN_TOKEN=

# Written by setup-instance
INTENTLOCK_API_KEY_GITHUB_ASSISTANT=
INTENTLOCK_API_KEY_SUPPORT_ASSISTANT=
INTENTLOCK_API_KEY_FILES_ASSISTANT=

# Model: fake needs nothing; openai-compatible needs LLM_BASE_URL + LLM_MODEL; anthropic needs LLM_API_KEY + LLM_MODEL
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Required for github-assistant and the seed
GITHUB_TOKEN=
GITHUB_OWNER=

# Optional
INTENTLOCK_URL=http://localhost:3000
DEMO_USER=member@acme-demo.dev
DEMO_TURN_DELAY_MS=1500
DEMO_FORCE_ATTACK=0
GITHUB_PUBLIC_REPO=public-app
GITHUB_PRIVATE_REPO=private-notes
MAILPIT_URL=http://localhost:8025
DEMO_SANDBOX=
DEMO_RECEIVER_URL=http://localhost:8787/collect
DEMO_RECEIVER_PORT=8787
DEMO_RUNNER_PORT=8790
