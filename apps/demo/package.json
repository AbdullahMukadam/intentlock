{
  "name": "@intentlock/demo",
  "version": "0.0.0",
  "description": "Intentlock demo agents (GitHub, support, files), setup + seed scripts, split-screen runner.",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "setup-instance": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/setup.ts",
    "seed": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env seed/seed.ts",
    "github-assistant": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/run.ts github-assistant",
    "files-assistant": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/run.ts files-assistant",
    "receiver": "tsx src/receiver.ts",
    "support-assistant": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/run.ts support-assistant",
    "run": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/run.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "runner": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/runner.ts"
  },
  "dependencies": {
    "@intentlock/core": "workspace:*",
    "@intentlock/guard": "workspace:*",
    "@intentlock/sdk": "workspace:*",
    "@octokit/rest": "^22.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@intentlock/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
