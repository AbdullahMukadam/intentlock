# Copy to apps/server/.env

# Required
DATABASE_URL=postgresql://intentlock:intentlock@localhost:5432/intentlock

# Required for migrations and tests
DIRECT_URL=postgresql://intentlock:intentlock@localhost:5432/intentlock
TEST_DATABASE_URL=postgresql://intentlock:intentlock@localhost:5432/intentlock_test

# Required in production (dev generates one): PEM from `node packages/cli/dist/bin.js keygen --env`
SIGNING_KEY=

# Optional
PUBLIC_URL=http://localhost:3001
ORG_NAME=Acme Demo
TRUST_PROXY=0
INTENTLOCK_DEMO=0
LOG_LEVEL=info
LICENSE_FILE=
API_KEY_PEPPER=
SIGNING_KEY_PREVIOUS=
CORS_ORIGINS=

# Optional: email (SMTP_FROM is required when SMTP_URL is set)
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM=Intentlock <intentlock@acme-demo.dev>
# Optional: Slack/Discord webhook for new holds (https only)
HOLD_WEBHOOK_URL=

# Optional: Google / GitHub sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: database limits (defaults shown)
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_MS=5000
DATABASE_TX_MAX_WAIT_MS=2000
DATABASE_TX_TIMEOUT_MS=5000
