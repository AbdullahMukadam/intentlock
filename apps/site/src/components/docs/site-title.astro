---
import Icon from "../icon.astro";
---

<a href="/" class="site-title">
  <span class="mark" aria-hidden="true">
    <Icon name="lock-keyhole" class="glyph" strokeWidth={2.25} />
  </span>
  <span translate="no">Intentlock</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--foreground);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .mark {
    display: flex;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: var(--primary);
    color: var(--primary-foreground);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18);
  }

  .mark :global(.glyph) {
    width: 55%;
    height: 55%;
  }
</style>
