---
import Search from "@astrojs/starlight/components/Search.astro";

import { GITHUB_URL, SIGN_IN_URL } from "../../lib/links";
import Icon, { type IconName } from "../icon.astro";

const { sidebar } = Astro.locals.starlightRoute;
type Entry = (typeof sidebar)[number];

const GROUP_ICONS: Record<string, IconName> = {
  "Get started": "book-open",
  "How it works": "lightbulb",
  SDK: "package",
  Reference: "braces",
  "Self-hosting": "server",
  Project: "shield",
};

const hasCurrent = (entry: Entry): boolean =>
  entry.type === "link" ? entry.isCurrent : entry.entries.some(hasCurrent);
---

<div class="search"><Search /></div>

<ul class="groups">
  {
    sidebar.map((group) =>
      group.type === "group" ? (
        <li>
          <details open={hasCurrent(group) || !group.collapsed}>
            <summary>
              <Icon name={GROUP_ICONS[group.label] ?? "book-open"} class="group-icon" />
              <span>{group.label}</span>
              <Icon name="chevron-down" class="caret" />
            </summary>
            <ul>
              {group.entries.map(
                (entry) =>
                  entry.type === "link" && (
                    <li>
                      <a href={entry.href} aria-current={entry.isCurrent ? "page" : undefined}>
                        {entry.label}
                      </a>
                    </li>
                  ),
              )}
            </ul>
          </details>
        </li>
      ) : (
        <li>
          <a class="single" href={group.href} aria-current={group.isCurrent ? "page" : undefined}>
            {group.label}
          </a>
        </li>
      ),
    )
  }
</ul>

<div class="footer">
  <a href={GITHUB_URL} class="icon-button" aria-label="GitHub">
    <Icon name="github" />
  </a>
  <a href={SIGN_IN_URL} class="mobile-sign-in">Sign in</a>
  <button type="button" class="icon-button" data-theme-toggle aria-label="Toggle dark mode">
    <Icon name="sun" class="sun" />
    <Icon name="moon" class="moon" />
  </button>
</div>

<script>
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("starlight-theme", next);
    } catch {
      return;
    }
  });
</script>

<style>
  .search :global(button[data-open-modal]) {
    width: 100%;
    height: 2.75rem;
    max-width: none;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    padding-inline: 1rem;
    color: color-mix(in oklch, var(--foreground) 70%, transparent);
    font-size: 0.875rem;
  }

  .search :global(button[data-open-modal] > span) {
    display: block;
  }

  .search :global(button[data-open-modal] kbd) {
    border-radius: 4px;
    background: transparent;
  }

  .groups,
  .groups ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    color: var(--foreground);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary span {
    flex: 1;
  }

  summary :global(.group-icon) {
    width: 1rem;
    height: 1rem;
  }

  summary :global(.caret) {
    width: 1rem;
    height: 1rem;
    color: color-mix(in oklch, var(--foreground) 60%, transparent);
    transition: transform 0.15s ease;
  }

  details[open] > summary :global(.caret) {
    transform: rotate(180deg);
  }

  details ul {
    padding-bottom: 0.5rem;
  }

  details a,
  .single {
    display: block;
    padding: 0.375rem 1rem 0.375rem 2.625rem;
    color: color-mix(in oklch, var(--foreground) 82%, var(--background));
    font-size: 0.875rem;
    line-height: 1.4;
    text-decoration: none;
  }

  details a:hover,
  .single:hover {
    color: var(--foreground);
  }

  details a[aria-current="page"],
  .single[aria-current="page"] {
    background: var(--muted);
    color: var(--foreground);
    font-weight: 500;
  }

  .footer {
    position: sticky;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--background);
    padding: 0.5rem 0.75rem;
  }

  .icon-button {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
  }

  .icon-button:hover {
    background: var(--muted);
  }

  .icon-button :global(svg) {
    width: 1.0625rem;
    height: 1.0625rem;
  }

  :global([data-theme="dark"]) .icon-button :global(.sun),
  :global(:root:not([data-theme="dark"])) .icon-button :global(.moon) {
    display: none;
  }

  .mobile-sign-in {
    margin-inline-end: auto;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  @media (min-width: 50rem) {
    .mobile-sign-in {
      display: none;
    }
  }
</style>
